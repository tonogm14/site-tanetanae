PORT=3002

# Desarrollo: WordPress todavía en el dominio principal
WP_API_URL=https://tanetanae.com/wp-json/wp/v2
WP_BASE=https://tanetanae.com

# Producción (Railway): WordPress movido al subdominio CMS
# WP_API_URL=https://cms.tanetanae.com/wp-json/wp/v2
# WP_BASE=https://cms.tanetanae.com

# Dominio público del nuevo sitio (para reescribir URLs en sitemaps)
SITE_URL=https://www.tanetanae.com

CACHE_TTL=300

# PostgreSQL — fallback cache cuando WordPress no responde
# En Railway: pegar el DATABASE_URL del servicio Postgres
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
# DATABASE_SSL=false  ← solo para desarrollo local sin SSL

# CORS — orígenes adicionales permitidos (separados por coma)
# Útil para el URL de ngrok en desarrollo o dominios staging
# ALLOWED_ORIGIN=https://abc123.ngrok-free.app,https://staging.tanetanae.com

# Webhook — clave compartida con WordPress para autenticar notificaciones
# Generar con: openssl rand -hex 32
# WEBHOOK_SECRET=pon_aqui_una_clave_larga_y_aleatoria

# Filtro de palabras obscenas — palabras adicionales a la lista interna
# Separa con coma, sin espacios. El servidor debe reiniciarse para aplicar cambios.
# PROFANITY_EXTRA=nuevapalabra,otrapalabra,maspalabras

# ── Variable para el servicio WEB (server.js) ──────────────
# URL interna del API para inyectar meta tags OG en el HTML (bots de redes sociales)
# En Railway usar la URL de red privada del servicio API:
# API_URL=http://api.railway.internal:3002
